  "description": "Client-side toggle for fog/darkness/blindness/nausea (K) and entity glow (N).",
  "authors": ["Player"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.visualhelper.VisualHelperClient"
    ]
  },
  "mixins": [
    "visualhelper.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
